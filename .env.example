# LLM API Keys (사용할 프로바이더의 키만 설정하면 됩니다)
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
ANTHROPIC_API_KEY=sk-ant-...
CEREBRAS_API_KEY=csk-...
# 실행 프로파일 (CLI --profile 로 선택)
#   --profile test-cerebras : Cerebras API (deep/quick=gpt-oss-120b)
#   --profile test-local    : Ollama 로컬 (gemma4:e4b)
#   --profile prod          : Google Gemini 3.1 Flash

# R&D 심의 설정 (선택사항)
# RDAGENTS_LLM_PROVIDER=cerebras
# RDAGENTS_DEEP_THINK_LLM=gpt-oss-120b
# RDAGENTS_QUICK_THINK_LLM=gpt-oss-120b
# RDAGENTS_OUTPUT_LANGUAGE=Korean
# RDAGENTS_MAX_DEBATE_ROUNDS=2
# RDAGENTS_MAX_AUDIT_ROUNDS=1
# RDAGENTS_MAX_MEMORY_ENTRIES=5
# RDAGENTS_MAX_MEMORY_CHARS=12000
# RDAGENTS_MAX_REPORT_BYTES=5000000
# RDAGENTS_REPORT_CHUNK_CHARS=4000
# RDAGENTS_REPORT_TOP_K=4
# RDAGENTS_CHECKPOINT_ENABLED=false
# RDAGENTS_CHECKPOINT_PATH=~/.rdagents/checkpoints/reviews.sqlite
# 기본 결과 저장 위치는 프로젝트 내부 `results/`입니다.
# 외부 저장소를 사용하려면 아래 값을 절대 경로로 지정하세요.
# RDAGENTS_RESULTS_DIR=D:/rdagents-results
